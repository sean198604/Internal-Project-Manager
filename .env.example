# ── Database ──────────────────────────────────────────
DATABASE_URL="postgresql://ipm:ipm_dev_only@localhost:5432/ipm?schema=public"

# ── Application ───────────────────────────────────────
# 32 bytes 以上随机值，用于 JWT 签名与敏感字段加密
APP_SECRET="replace-with-a-random-32-bytes-string"
# 业务展示时区（数据库统一存 UTC）
APP_TIMEZONE="Asia/Taipei"
PORT=3010

# ── Initial accounts ──────────────────────────────────
# 首次登录后请立即修改
ADMIN_INITIAL_PASSWORD=""
MASTER_INITIAL_PASSWORD=""

# ── Upload ────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=20

# ── AI (P2 · 可选，不配置则系统正常运行) ──────────────────
# FastGPT 已独立部署，本项目仅通过 API 调用，不重新部署、不修改、不含其源码
AI_ENABLED=false
FASTGPT_BASE_URL="http://192.168.1.246:3000/api"
FASTGPT_API_KEY=""
FASTGPT_APP_ID=""
